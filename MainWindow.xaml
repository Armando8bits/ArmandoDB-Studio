<Window x:Class="MySmdb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArmandoDB Studio" Width="1280" Height="800" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Conectar..." Click="Connect_Click"/>
                <MenuItem Header="_Desconectar" Click="Disconnect_Click"/>
                <Separator/>
                <MenuItem Header="_Nueva consulta" InputGestureText="Ctrl+N" Click="NewQuery_Click"/>
                <MenuItem Header="_Abrir..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="_Guardar" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Guardar c_omo..." Click="SaveAs_Click"/>
                <MenuItem Header="C_errar pestaña" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <Separator/>
                <MenuItem Header="_Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Consulta">
                <MenuItem Header="_Ejecutar" InputGestureText="Ctrl+E / F5" Click="Execute_Click"/>
                <MenuItem Header="_Cancelar ejecución" InputGestureText="Alt+Pausa" Click="Cancel_Click"/>
            </MenuItem>
            <MenuItem Header="_Ventana">
                <MenuItem Header="Mostrar u ocultar el _explorador de objetos" InputGestureText="Ctrl+B" Click="ToggleExplorer_Click"/>
                <Separator/>
                <MenuItem Header="_Anclar o desanclar pestaña" Click="TogglePin_Click"/>
                <MenuItem Header="Pestaña _siguiente" InputGestureText="Ctrl+Tab" Click="NextTab_Click"/>
                <MenuItem Header="Pestaña a_nterior" InputGestureText="Ctrl+Mayús+Tab" Click="PreviousTab_Click"/>
                <Separator/>
                <MenuItem Header="Dividir: _izquierda / derecha" Click="SplitSideBySide_Click"/>
                <MenuItem Header="Dividir: a_rriba / abajo" Click="SplitStacked_Click"/>
                <MenuItem Header="_Mover pestaña al otro grupo" Click="MoveToOtherGroup_Click"/>
                <MenuItem Header="_Quitar la división" Click="Unsplit_Click"/>
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="_Fuente y tamaño..." Click="Font_Click"/>
                <MenuItem Header="_Tema">
                    <MenuItem x:Name="ThemeSystemItem" Header="Según _Windows" IsCheckable="True" Click="Theme_Click" Tag="System"/>
                    <MenuItem x:Name="ThemeLightItem" Header="_Claro" IsCheckable="True" Click="Theme_Click" Tag="Light"/>
                    <MenuItem x:Name="ThemeDarkItem" Header="_Oscuro" IsCheckable="True" Click="Theme_Click" Tag="Dark"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ToggleButton x:Name="ExplorerToggle" Content="Explorador" IsChecked="True" Click="ToggleExplorer_Click" Padding="6,2"
                              ToolTip="Mostrar u ocultar el explorador de objetos (Ctrl+B)"/>
                <Separator/>
                <Button Content="Conectar" Click="Connect_Click" Padding="6,2"/>
                <Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect_Click" Padding="6,2" IsEnabled="False"
                        ToolTip="Desconectar la conexión seleccionada en el explorador (o la de la pestaña actual)"/>
                <Button Content="Nueva consulta" Click="NewQuery_Click" Padding="6,2" ToolTip="Ctrl+N"/>
                <Separator/>
                <ComboBox x:Name="DatabaseCombo" Width="190" ToolTip="Base de datos de la pestaña actual"
                          SelectionChanged="DatabaseCombo_SelectionChanged"/>
                <Separator/>
                <Button x:Name="ExecuteButton" Click="Execute_Click" Padding="6,2" ToolTip="Ejecutar (Ctrl+E o F5): la selección o todo el contenido">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" Foreground="#FF2E9E4F" Margin="0,0,4,0"/>
                        <TextBlock Text="Ejecutar"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Click="Cancel_Click" Padding="6,2" IsEnabled="False" ToolTip="Cancelar ejecución (Alt+Pausa)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="■" Foreground="Firebrick" Margin="0,0,4,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Compacta, como antes del tema Fluent (que le da mucho más relleno). -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Brush.StatusBar}" Foreground="{DynamicResource Brush.StatusBarText}"
                   Padding="0" MinHeight="0">
            <StatusBar.Resources>
                <Style TargetType="StatusBarItem" BasedOn="{StaticResource {x:Type StatusBarItem}}">
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </StatusBar.Resources>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Sin conexión"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ConnectionText" Margin="12,0"/>
                    <TextBlock x:Name="TimeText" Margin="12,0"/>
                    <TextBlock x:Name="RowsText" Margin="12,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="270" MinWidth="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="ExplorerPanel">
                <DockPanel DockPanel.Dock="Top" Background="#FF4D6082">
                    <Button DockPanel.Dock="Right" Content="«" Click="ToggleExplorer_Click" Padding="7,0,7,2" FontSize="14"
                            Background="Transparent" Foreground="White" BorderThickness="0" Focusable="False" Cursor="Hand"
                            ToolTip="Ocultar el explorador de objetos (Ctrl+B)"/>
                    <TextBlock Text="Explorador de objetos" Padding="6,3" Foreground="White" VerticalAlignment="Center"/>
                </DockPanel>
                <TreeView x:Name="Explorer" BorderThickness="0" TreeViewItem.Expanded="Explorer_Expanded"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" x:Name="ExplorerSplitter" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Splitter}"/>

            <!-- Uno o dos grupos de pestañas (vista dividida); se construyen en código. -->
            <Grid Grid.Column="2" x:Name="GroupsGrid"/>
        </Grid>
    </DockPanel>
</Window>
