<UserControl x:Class="MySmdb.QueryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">
    <UserControl.Resources>
        <!-- Con plantilla propia el encabezado no se come los "_" de los nombres de columna. -->
        <DataTemplate x:Key="ColumnHeaderTemplate">
            <TextBlock Text="{Binding}"/>
        </DataTemplate>

        <!-- Panel de búsqueda (Ctrl+F) con los colores del tema: el de AvalonEdit es blanco fijo
             y sus botones quedan cortados con los controles más grandes del tema Fluent. -->
        <ControlTemplate x:Key="SearchPanelTemplate" TargetType="search:SearchPanel">
            <Border Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.PanelBorder}"
                    BorderThickness="1" CornerRadius="0,0,0,4" Padding="6" Cursor="Arrow" TextElement.FontFamily="Segoe UI"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="PART_searchTextBox" Width="230"
                                 Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Command="search:SearchCommands.FindPrevious" Content="↑" Margin="4,0,0,0" Padding="9,2"
                                ToolTip="{Binding Localization.FindPreviousText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Command="search:SearchCommands.FindNext" Content="↓" Margin="2,0,0,0" Padding="9,2"
                                ToolTip="{Binding Localization.FindNextText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Command="search:SearchCommands.CloseSearchPanel" Content="✕" Margin="2,0,0,0" Padding="9,2"
                                ToolTip="Cerrar (Esc)"/>
                    </StackPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="Mayúsculas" Margin="0,0,10,0" MinWidth="0"
                                  IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}"
                                  ToolTip="{Binding Localization.MatchCaseText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <CheckBox Content="Palabra" Margin="0,0,10,0" MinWidth="0"
                                  IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}"
                                  ToolTip="{Binding Localization.MatchWholeWordsText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <CheckBox Content="Regex" MinWidth="0"
                                  IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}"
                                  ToolTip="{Binding Localization.UseRegexText, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </WrapPanel>
                    <!-- "Mostrando 1 de X coincidencias" / "Se encontraron 0 resultados"; lo rellena QueryTab. -->
                    <TextBlock x:Name="MatchInfo" Margin="2,4,0,0" FontSize="11"
                               Foreground="{DynamicResource Brush.SecondaryText}"/>

                </StackPanel>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="60"/>
        </Grid.RowDefinitions>

        <avalon:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13"
                           ShowLineNumbers="True" SyntaxHighlighting="TSQL"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Splitter}"/>

        <TabControl Grid.Row="2" x:Name="ResultTabs">
            <TabItem Header="Cuadrícula">
                <ContentControl x:Name="ResultsHost"/>
            </TabItem>
            <TabItem Header="Mensajes">
                <avalon:TextEditor x:Name="Messages" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="4,2"
                                   WordWrap="True"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </TabItem>
            <!-- Sin ajuste de línea: el árbol del plan se lee por su sangría. -->
            <TabItem Header="Plan de ejecución">
                <avalon:TextEditor x:Name="PlanView" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="4,2"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
