<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Comandos habituales (desde la carpeta del proyecto, C:\miscreaciones\MySmdb):

    Compilar (cierra antes la aplicación si está abierta; si no, el .exe queda bloqueado):
        dotnet build -c Release

    Ejecutar el .exe ya compilado:
        .\bin\Release\net10.0-windows\ArmandoDBStudio.exe

    Compilar y ejecutar en un solo paso:
        dotnet run -c Release

    Generar el instalador (Setup.exe con .NET incluido, para equipos sin .NET; requiere Inno Setup 6):
        .\installer\build-installer.ps1
    El resultado queda en installer\Output. La versión sale de <Version> más abajo.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MySmdb</RootNamespace>
    <AssemblyName>ArmandoDBStudio</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ArmandoDB Studio</Product>
    <AssemblyTitle>ArmandoDB Studio</AssemblyTitle>
    <Company>ArmandoDB Studio</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono del .exe (Explorador, barra de tareas, accesos directos). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- El mismo icono, para la barra de título de las ventanas. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutomaticGraphLayout" Version="1.1.12" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
