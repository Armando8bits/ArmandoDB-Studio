<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Comandos habituales (desde la carpeta del proyecto, C:\miscreaciones\MySmdb):

    Compilar solo app (cierra antes la aplicación si está abierta; si no, el .exe queda bloqueado):
        dotnet build -c Release

    Ejecutar el .exe ya compilado:
        .\bin\Release\net10.0-windows\ArmandoDBStudio.exe

    Compilar y ejecutar en un solo paso:
        dotnet run -c Release

    Ejecutar las pruebas automáticas (no hace falta cerrar la aplicación):
        dotnet test tests\MySmdb.Tests

    *Compilar línea de comandos y APP (armandodb.exe; su código está en Cli\CliRunner.cs y su manual en CLI.md):
        dotnet build armandodb-cli -c Release

    *Compilar y probar la línea de comandos (armandodb.exe; su código está en Cli\CliRunner.cs y su manual en CLI.md):
        dotnet build armandodb-cli
        .\armandodb-cli\bin\Debug\net10.0-windows\armandodb.exe ayuda

    Generar el instalador, uno de los dos es suficiente (Setup.exe con .NET incluido, para equipos sin .NET; requiere Inno Setup 6):
        .\installer\build-installer.ps1
        powershell -ExecutionPolicy Bypass -File .\installer\build-installer.ps1

    El resultado queda en installer\Output. La versión sale de <Version> más abajo.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MySmdb</RootNamespace>
    <AssemblyName>ArmandoDBStudio</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Las pruebas (tests\MySmdb.Tests) y el arranque de consola (armandodb-cli) son otros proyectos: sus archivos no se compilan con la aplicación. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;armandodb-cli\**</DefaultItemExcludes>
    <Product>ArmandoDB Studio</Product>
    <AssemblyTitle>ArmandoDB Studio</AssemblyTitle>
    <Company>ArmandoDB Studio</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono del .exe (Explorador, barra de tareas, accesos directos). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- El mismo icono, para la barra de título de las ventanas. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AdoNetCore.AseClient" Version="0.19.2" />
    <PackageReference Include="AutomaticGraphLayout" Version="1.1.12" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
