<UserControl x:Class="MySmdb.QueryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">
    <UserControl.Resources>
        <!-- Con plantilla propia el encabezado no se come los "_" de los nombres de columna. -->
        <DataTemplate x:Key="ColumnHeaderTemplate">
            <TextBlock Text="{Binding}"/>
        </DataTemplate>

        <!-- Panel de búsqueda (Ctrl+F) con los colores del tema: el de AvalonEdit es blanco fijo
             y sus botones quedan cortados con los controles más grandes del tema Fluent. -->
        <ControlTemplate x:Key="SearchPanelTemplate" TargetType="search:SearchPanel">
            <Border Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.PanelBorder}"
                    BorderThickness="1" CornerRadius="0,0,0,4" Padding="6" Cursor="Arrow" TextElement.FontFamily="Segoe UI"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="PART_searchTextBox" Width="230"
                                 Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Command="search:SearchCommands.FindPrevious" Content="↑" Margin="4,0,0,0" Padding="9,2"
                                ToolTip="{Binding Localization.FindPreviousText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Command="search:SearchCommands.FindNext" Content="↓" Margin="2,0,0,0" Padding="9,2"
                                ToolTip="{Binding Localization.FindNextText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Button Command="search:SearchCommands.CloseSearchPanel" Content="✕" Margin="2,0,0,0" Padding="9,2"
                                ToolTip="Cerrar (Esc)"/>
                    </StackPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="Mayúsculas" Margin="0,0,10,0" MinWidth="0"
                                  IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}"
                                  ToolTip="{Binding Localization.MatchCaseText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <CheckBox Content="Palabra" Margin="0,0,10,0" MinWidth="0"
                                  IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}"
                                  ToolTip="{Binding Localization.MatchWholeWordsText, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <CheckBox Content="Regex" MinWidth="0"
                                  IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}"
                                  ToolTip="{Binding Localization.UseRegexText, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </WrapPanel>
                    <!-- "Mostrando 1 de X coincidencias" / "Se encontraron 0 resultados"; lo rellena QueryTab. -->
                    <TextBlock x:Name="MatchInfo" Margin="2,4,0,0" FontSize="11"
                               Foreground="{DynamicResource Brush.SecondaryText}"/>

                </StackPanel>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid>
        <!-- Editor arriba y resultados abajo. El panel de resultados se puede minimizar (queda solo su fila de
             pestañas) o maximizar (ocupa todo y oculta el editor); ver SetResultsPane. -->
        <Grid.RowDefinitions>
            <RowDefinition x:Name="EditorRow" Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ResultsRow" Height="*" MinHeight="60"/>
        </Grid.RowDefinitions>

        <avalon:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13"
                           ShowLineNumbers="True" SyntaxHighlighting="TSQL"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

        <GridSplitter Grid.Row="1" x:Name="ResultsSplitter" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Splitter}"/>

        <!-- Minimizar / maximizar el panel de resultados, sobre el extremo derecho de su fila de pestañas. -->
        <StackPanel Grid.Row="2" Panel.ZIndex="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0">
            <Button x:Name="MinimizeResultsButton" Click="MinimizeResults_Click" Padding="5,3" Margin="0,0,2,0" Focusable="False"/>
            <Button x:Name="MaximizeResultsButton" Click="MaximizeResults_Click" Padding="5,3" Focusable="False"/>
        </StackPanel>

        <TabControl Grid.Row="2" x:Name="ResultTabs">
            <TabItem Header="Cuadrícula">
                <DockPanel>
                    <!-- Filtro sobre los resultados ya obtenidos: no vuelve a ejecutar la consulta.
                         Oculto por defecto para no quitar espacio; se muestra con Ctrl+Mayús+L o desde el menú de la cuadrícula. -->
                    <DockPanel DockPanel.Dock="Top" x:Name="ResultFilterBar" Margin="4,4,4,2" Visibility="Collapsed">
                        <Grid DockPanel.Dock="Left" Width="300">
                            <TextBox x:Name="ResultFilter" TextChanged="ResultFilter_TextChanged" IsEnabled="False"
                                     PreviewKeyDown="ResultFilter_PreviewKeyDown"
                                     ToolTip="Muestra solo las filas que contienen este texto en alguna columna. Esc lo oculta."/>
                            <TextBlock x:Name="ResultFilterHint" Text="Filtrar resultados..." Margin="11,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{DynamicResource Brush.SecondaryText}"/>
                        </Grid>
                        <!-- El texto se borra con la "x" que el propio cuadro muestra al escribir. -->
                        <Button DockPanel.Dock="Left" Content="Cerrar filtro" Margin="6,0,0,0" Padding="10,2" Click="CloseResultFilter_Click"
                                ToolTip="Cerrar el filtro (Esc o Ctrl+Mayús+L)"/>
                        <TextBlock x:Name="FilterInfo" Margin="12,0,4,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.SecondaryText}"/>
                    </DockPanel>
                    <ContentControl x:Name="ResultsHost"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Mensajes">
                <avalon:TextEditor x:Name="Messages" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="4,2"
                                   WordWrap="True"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </TabItem>
            <!-- El plan se ve como diagrama (árbol de pasos) o como texto, a elegir. -->
            <!-- Oculta hasta que se pide un plan: vacía solo confunde. -->
            <TabItem x:Name="PlanTabItem" Header="Plan de ejecución" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="Cerrar plan" Padding="10,2" Click="ClosePlan_Click"
                                ToolTip="Oculta esta pestaña; vuelve a aparecer al pedir otro plan"/>
                        <RadioButton x:Name="PlanAsDiagram" Content="Diagrama" GroupName="PlanView" VerticalAlignment="Center"
                                     Checked="PlanViewMode_Changed" Unchecked="PlanViewMode_Changed"
                                     ToolTip="Árbol de pasos; Ctrl+rueda para acercar o alejar"/>
                        <RadioButton x:Name="PlanAsText" Content="Texto" GroupName="PlanView" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <ContentControl x:Name="PlanLegend" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <!-- Sin ajuste de línea: el árbol de texto se lee por su sangría. -->
                        <avalon:TextEditor x:Name="PlanView" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="4,2"
                                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <ScrollViewer x:Name="PlanDiagramScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource Brush.EditorBackground}" PreviewMouseWheel="PlanDiagramScroll_PreviewMouseWheel">
                            <StackPanel x:Name="PlanDiagramPanel" HorizontalAlignment="Left"/>
                        </ScrollViewer>
                        <!-- Aviso mientras se genera el plan: con latencia (túnel, servidor lejano) tarda. -->
                        <Border x:Name="PlanLoading" Visibility="Collapsed" Background="{DynamicResource Brush.EditorBackground}">
                            <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Generando el plan de ejecución..." HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ProgressBar IsIndeterminate="True" Height="6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
