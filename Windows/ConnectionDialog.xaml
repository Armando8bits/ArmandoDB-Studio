<Window x:Class="MySmdb.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectar con la base de datos" Width="840" Height="630"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <!-- BasedOn: sin él, estos estilos reemplazarían a los del tema Fluent (claro/oscuro). -->
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4"/>
            <Style.Triggers>
                <!-- Para que el icono también se vea apagado cuando el botón está deshabilitado -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Izquierda: conexiones guardadas -->
        <Border Background="{DynamicResource Brush.PanelBackground}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Conexiones guardadas" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Margin="0,0,3,0" Click="New_Click"
                            ToolTip="Vaciar el formulario para crear una conexión nueva">
                        <StackPanel Orientation="Horizontal">
                            <!-- Signo más -->
                            <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Data="M8,3 V13 M3,8 H13" Stroke="#FF34A853" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Nueva" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Margin="3,0,0,0" Click="Delete_Click"
                            ToolTip="Borrar la conexión seleccionada">
                        <StackPanel Orientation="Horizontal">
                            <!-- Papelera -->
                            <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Data="M4.5,5 L5.2,14 H10.8 L11.5,5 Z" Fill="#FFF7D9D5" Stroke="#FFC0392B" StrokeLineJoin="Round"/>
                                <Path Data="M3,4.5 H13 M6.5,4.5 V2.5 H9.5 V4.5 M7,7.5 V11.5 M9,7.5 V11.5" Stroke="#FFC0392B" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                            <TextBlock Text="Borrar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <Grid>
                    <!-- Ocupa todo el alto disponible, anclada arriba: no cambia de sitio al elegir otra conexión. -->
                    <ListBox x:Name="SavedList" VerticalAlignment="Stretch" SelectionChanged="SavedList_SelectionChanged"
                             MouseDoubleClick="SavedList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4" ToolTip="{Binding Summary}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="PROD" FontSize="10" FontWeight="Bold" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.ProdText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProduction}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Brush.SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyHint" Text="Aún no hay conexiones guardadas.&#10;Rellena el formulario y pulsa Guardar o Conectar."
                               Foreground="{DynamicResource Brush.SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               Margin="16" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Derecha: datos de la conexión -->
        <DockPanel Grid.Column="1" Margin="18,12,18,14">
            <TextBlock DockPanel.Dock="Top" x:Name="FormTitle" Text="Nueva conexión" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" x:Name="TestButton" Click="Test_Click"
                        ToolTip="Comprobar los datos sin cerrar esta ventana">
                    <StackPanel Orientation="Horizontal">
                        <!-- Rayo -->
                        <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M9.5,1 L3.5,9 H7.5 L6.5,15 L12.5,6.5 H8.5 Z" Fill="#FFF2B01E" Stroke="#FF9A7412" StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock Text="Probar conexión" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <!-- Aspa -->
                        <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#FF7A7A7A" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" x:Name="ConnectButton" MinWidth="90" Margin="8,0,0,0"
                        IsDefault="True" FontWeight="SemiBold" Click="Connect_Click">
                    <StackPanel Orientation="Horizontal">
                        <!-- Enchufe -->
                        <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M5.5,1.5 V5 M10.5,1.5 V5 M8,12 V15" Stroke="#FF1F6E36" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M3.5,5 H12.5 V8 C12.5,10.5 10.5,12 8,12 C5.5,12 3.5,10.5 3.5,8 Z"
                                  Fill="#FF34A853" Stroke="#FF1F6E36" StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock Text="Conectar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" x:Name="SaveButton" MinWidth="80" Click="Save_Click"
                        ToolTip="Guardar la conexión sin conectarse">
                    <StackPanel Orientation="Horizontal">
                        <!-- Disquete -->
                        <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M2,2 H11.5 L14,4.5 V14 H2 Z" Fill="#FF3B6FB5" Stroke="#FF274D80" StrokeLineJoin="Round"/>
                            <Path Data="M4.5,2.5 H10 V6 H4.5 Z" Fill="White"/>
                            <Path Data="M4,9 H12 V13.5 H4 Z" Fill="#FFDDE8F7"/>
                        </Canvas>
                        <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Resultado de probar/guardar y errores de validación, sin ventanas emergentes -->
            <DockPanel DockPanel.Dock="Bottom" MinHeight="34" Margin="0,10,0,0">
                <!-- Arco que gira mientras se prueba la conexión o se conecta (ver SetBusy): indica que hay actividad. -->
                <Path DockPanel.Dock="Left" x:Name="BusySpinner" Visibility="Collapsed" Width="16" Height="16" Margin="0,1,8,0"
                      VerticalAlignment="Top" Data="M8,1.5 A6.5,6.5 0 1 1 1.5,8" Stroke="{DynamicResource Brush.SecondaryText}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="BusySpinnerRotation"/>
                    </Path.RenderTransform>
                </Path>
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap"/>
            </DockPanel>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Nombre:"/>
                    <TextBox Grid.Column="1" x:Name="NameBox"
                             ToolTip="Opcional. Identifica la conexión y su sesión: los archivos abiertos se recuerdan por este nombre."/>
                    <Label Grid.Row="1" Content="Tipo de base:"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="TypeCombo" Margin="0,4" Width="140" SelectionChanged="TypeCombo_SelectionChanged">
                            <ComboBoxItem Content="MySQL"/>
                            <ComboBoxItem Content="SQLite"/>
                            <ComboBoxItem Content="SQL Server"/>
                            <ComboBoxItem Content="Sybase ASE"/>
                        </ComboBox>
                        <CheckBox x:Name="ProductionCheck" Content="Producción" Margin="20,0,0,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.ProdText}" FontWeight="SemiBold"
                                  ToolTip="Se resalta en rojo y pide confirmación antes de cualquier sentencia que modifique datos o estructura"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,8"/>

                <!-- Solo se muestran los campos del tipo elegido. En MySQL y SQL Server, el servidor y el túnel SSH
                     van en pestañas para que la ventana no crezca; fuera quedan los datos comunes. -->
                <StackPanel x:Name="MySqlPanel">
                    <TabControl x:Name="ConnectionTabs" MinHeight="290">
                        <TabItem x:Name="ServerTab" Header="Servidor MySQL">
                            <Grid Margin="6,8,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Content="Servidor:"/>
                                <DockPanel Grid.Column="1">
                                    <TextBox DockPanel.Dock="Right" x:Name="PortBox" Width="100" MaxLength="5" ToolTip="Puerto (3306 en MySQL, 1433 en SQL Server, 5000 en Sybase ASE)"/>
                                    <Label DockPanel.Dock="Right" Content="Puerto:" Padding="10,0,6,0"/>
                                    <TextBox x:Name="HostBox" ToolTip="Nombre o dirección IP del servidor"/>
                                </DockPanel>

                                <!-- Solo SQL Server -->
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="WindowsAuthCheck" Content="Autenticación de Windows" Margin="0,4,0,2"
                                          Visibility="Collapsed" Checked="WindowsAuth_Changed" Unchecked="WindowsAuth_Changed"
                                          ToolTip="Entrar con tu usuario de Windows, sin usuario ni contraseña de SQL Server"/>

                                <Label Grid.Row="2" Content="Usuario:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserBox"/>

                                <Label Grid.Row="3" Content="Contraseña:"/>
                                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBox" Margin="0,4"/>

                                <Label Grid.Row="4" Content="Base de datos:"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DatabaseBox" ToolTip="Opcional: base de datos inicial"/>

                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TunnelHint" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                                           Foreground="{DynamicResource Brush.SecondaryText}"
                                           Text="Túnel SSH activado: «Servidor» y «Puerto» son los de la base vistos desde el servidor SSH (normalmente 127.0.0.1 y el puerto de la base)."/>
                            </Grid>
                        </TabItem>

                        <!-- La aplicación abre y cierra el túnel sola. -->
                        <TabItem x:Name="SshTab" Header="Túnel SSH">
                            <StackPanel Margin="6,8,6,6">
                    <CheckBox x:Name="SshCheck" Content="Conectar mediante un túnel SSH" Margin="0,0,0,4"
                              Checked="SshCheck_Changed" Unchecked="SshCheck_Changed"/>
                    <Grid x:Name="SshPanel" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <!-- Más ancha que la de la pestaña del servidor: "Contraseña SSH:" y "Frase de la clave:" no cabían. -->
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Servidor SSH:"/>
                        <DockPanel Grid.Column="1">
                            <TextBox DockPanel.Dock="Right" x:Name="SshPortBox" Width="100" MaxLength="5" ToolTip="Puerto SSH (22 por defecto)"/>
                            <Label DockPanel.Dock="Right" Content="Puerto:" Padding="10,0,6,0"/>
                            <TextBox x:Name="SshHostBox" ToolTip="Servidor al que se entra por SSH (la VM, el bastión...)"/>
                        </DockPanel>

                        <Label Grid.Row="1" Content="Usuario SSH:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SshUserBox"/>

                        <Label Grid.Row="2" Content="Contraseña SSH:"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="SshPasswordBox" Margin="0,4"
                                     ToolTip="Opcional si usas una clave privada"/>

                        <Label Grid.Row="3" Content="Clave privada:"/>
                        <DockPanel Grid.Row="3" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="Examinar..." Margin="6,4,0,4" Click="BrowseKey_Click"/>
                            <TextBox x:Name="SshKeyBox" ToolTip="Opcional: archivo de clave privada en formato OpenSSH (id_rsa, id_ed25519...)"/>
                        </DockPanel>

                        <Label Grid.Row="4" Content="Frase de la clave:"/>
                        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="SshPassphraseBox" Margin="0,4"
                                     ToolTip="Solo si la clave privada está protegida con una frase"/>
                    </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <CheckBox x:Name="RememberCheck" Content="Recordar contraseñas" Margin="0,8,0,0"
                              ToolTip="Las contraseñas (base de datos y SSH) se guardan cifradas para tu usuario de Windows"/>
                </StackPanel>

                <Grid x:Name="SqlitePanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Archivo:"/>
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Content="Examinar..." Margin="6,4,0,4" Click="Browse_Click"/>
                        <TextBox x:Name="FileBox" ToolTip="Archivo de la base de datos SQLite"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Brush.SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Si el archivo no existe, se crea una base de datos nueva al conectar."/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
