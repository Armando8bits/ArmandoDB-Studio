<Window x:Class="MySmdb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySmdb"
        Title="ArmandoDB Studio" Icon="pack://application:,,,/ArmandoDBStudio;component/app.ico" Width="1280" Height="800" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem x:Name="ConnectMenuItem" Header="_Conectar..." Click="Connect_Click"/>
                <MenuItem x:Name="DisconnectMenuItem" Header="_Desconectar" Click="Disconnect_Click"/>
                <Separator/>
                <MenuItem Header="_Nueva consulta" InputGestureText="Ctrl+N" Click="NewQuery_Click"/>
                <MenuItem Header="_Abrir..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="_Guardar" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Guardar c_omo..." Click="SaveAs_Click"/>
                <MenuItem Header="C_errar pestaña" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <Separator/>
                <MenuItem Header="_Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem x:Name="UndoMenuItem" Header="_Deshacer" InputGestureText="Ctrl+Z" Click="Undo_Click" IsEnabled="False"/>
                <MenuItem x:Name="RedoMenuItem" Header="Re_hacer" InputGestureText="Ctrl+Y" Click="Redo_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Buscar..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="_Reemplazar..." InputGestureText="Ctrl+H" Click="Replace_Click"/>
                <Separator/>
                <MenuItem Header="_Formatear SQL" InputGestureText="Ctrl+Mayús+F" Click="Format_Click"/>
                <MenuItem Header="_Autocompletar" InputGestureText="Ctrl+Espacio" Click="Complete_Click"/>
                <MenuItem x:Name="AutoCompleteItem" Header="Sugerencias _automáticas al escribir" IsCheckable="True" Click="AutoComplete_Click"/>
                <Separator/>
                <MenuItem x:Name="SnippetsEnabledItem" Header="Fragmentos de código _activados (abreviatura + Tab)"
                          IsCheckable="True" Click="SnippetsEnabled_Click"/>
                <MenuItem Header="_Fragmentos de código..." Click="Snippets_Click"/>
            </MenuItem>
            <MenuItem Header="_Consulta">
                <MenuItem Header="_Ejecutar" InputGestureText="Ctrl+E / F5" Click="Execute_Click"/>
                <MenuItem Header="Mostrar el _plan de ejecución" InputGestureText="Ctrl+L" Click="Explain_Click"/>
                <MenuItem x:Name="CancelMenuItem" Header="_Cancelar ejecución" InputGestureText="Alt+Pausa" Click="Cancel_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Filtrar resultados" InputGestureText="Ctrl+Mayús+L" Click="ToggleResultFilter_Click"/>
            </MenuItem>
            <MenuItem Header="_Ventana">
                <MenuItem Header="Mostrar u ocultar el _explorador de objetos" InputGestureText="Ctrl+B" Click="ToggleExplorer_Click"/>
                <Separator/>
                <MenuItem Header="_Anclar o desanclar pestaña" Click="TogglePin_Click"/>
                <MenuItem Header="Pestaña _siguiente" InputGestureText="Ctrl+Tab" Click="NextTab_Click"/>
                <MenuItem Header="Pestaña a_nterior" InputGestureText="Ctrl+Mayús+Tab" Click="PreviousTab_Click"/>
                <Separator/>
                <MenuItem Header="Dividir: _izquierda / derecha" Click="SplitSideBySide_Click"/>
                <MenuItem Header="Dividir: a_rriba / abajo" Click="SplitStacked_Click"/>
                <MenuItem Header="_Mover pestaña al otro grupo" Click="MoveToOtherGroup_Click"/>
                <MenuItem Header="_Quitar la división" Click="Unsplit_Click"/>
                <Separator/>
                <MenuItem Header="Mover la pestaña a una _ventana nueva" Click="Float_Click"/>
                <MenuItem x:Name="DockMenuItem" Header="_Devolver la pestaña a la ventana principal" Click="Dock_Click" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="_Diagrama de la base de datos..." Click="Diagram_Click"/>
                <MenuItem Header="_Monitor de procesos (MySQL)..." Click="ProcessMonitor_Click"/>
                <Separator/>
                <MenuItem Header="_Fuente y tamaño..." Click="Font_Click"/>
                <MenuItem Header="_Confirmaciones antes de ejecutar">
                    <MenuItem x:Name="ConfirmDangerousItem" Header="_Sentencias peligrosas (UPDATE/DELETE sin WHERE, DROP, TRUNCATE)"
                              IsCheckable="True" Click="ConfirmSettings_Click"/>
                    <MenuItem x:Name="ConfirmProductionItem" Header="Cualquier _modificación en conexiones de producción"
                              IsCheckable="True" Click="ConfirmSettings_Click"/>
                </MenuItem>
                <MenuItem Header="_Tema">
                    <MenuItem x:Name="ThemeSystemItem" Header="Según _Windows" IsCheckable="True" Click="Theme_Click" Tag="System"/>
                    <MenuItem x:Name="ThemeLightItem" Header="_Claro" IsCheckable="True" Click="Theme_Click" Tag="Light"/>
                    <MenuItem x:Name="ThemeDarkItem" Header="_Oscuro" IsCheckable="True" Click="Theme_Click" Tag="Dark"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="A_yuda">
                <MenuItem Header="_Atajos de teclado..." Click="Shortcuts_Click"/>
                <MenuItem Header="_Registro de errores y consultas recuperadas..." Click="OpenDataFolder_Click"
                          ToolTip="Abre la carpeta con errors.log (para informar de un fallo) y las copias de recuperación"/>
                <MenuItem Header="_Acerca de ArmandoDB Studio..." Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ToggleButton x:Name="ExplorerToggle" Content="Explorador" IsChecked="True" Click="ToggleExplorer_Click" Padding="6,2"
                              ToolTip="Mostrar u ocultar el explorador de objetos (Ctrl+B)"/>
                <Separator/>
                <!-- El contenido (icono + texto) de Conectar y Desconectar se pone en código, con los iconos compartidos. -->
                <Button x:Name="ConnectButton" Click="Connect_Click" Padding="6,2"/>
                <Button x:Name="DisconnectButton" Click="Disconnect_Click" Padding="6,2" IsEnabled="False"
                        ToolTip="Desconectar la conexión seleccionada en el explorador (o la de la pestaña actual)"/>
                <Button Content="Nueva consulta" Click="NewQuery_Click" Padding="6,2" ToolTip="Ctrl+N"/>
                <Separator/>
                <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" Padding="7,0,7,2" FontSize="15" IsEnabled="False"
                        ToolTip="Deshacer (Ctrl+Z)" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" Padding="7,0,7,2" FontSize="15" IsEnabled="False"
                        ToolTip="Rehacer (Ctrl+Y)" ToolTipService.ShowOnDisabled="True"/>
                <Separator/>
                <ComboBox x:Name="DatabaseCombo" Width="270"
                          ToolTip="Base de datos de la pestaña actual. Elegir una de otra conexión cambia la pestaña a esa conexión."
                          SelectionChanged="DatabaseCombo_SelectionChanged"/>
                <Separator/>
                <Button x:Name="ExecuteButton" Click="Execute_Click" Padding="6,2" ToolTip="Ejecutar (Ctrl+E o F5): la selección o todo el contenido">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" Foreground="#FF2E9E4F" Margin="0,0,4,0"/>
                        <TextBlock Text="Ejecutar"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExplainButton" Click="Explain_Click" Padding="6,2"
                        ToolTip="Plan de ejecución estimado (Ctrl+L): de la selección o de todo el contenido, sin ejecutar la consulta">
                    <StackPanel Orientation="Horizontal">
                        <!-- Árbol de nodos -->
                        <Canvas Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Path Data="M4,3.5 V10.5 H9 M4,7 H9" Stroke="#FF3794FF" StrokeThickness="1.2"/>
                            <Path Data="M1.5,1 H6.5 V5 H1.5 Z M9,5 H13 V9 H9 Z M9,8.5 H13 V12.5 H9 Z" Fill="#FF3794FF"/>
                        </Canvas>
                        <TextBlock Text="Plan"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Click="Cancel_Click" Padding="6,2" IsEnabled="False" ToolTip="Cancelar ejecución (Alt+Pausa)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="■" Foreground="Firebrick" Margin="0,0,4,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button x:Name="DiagramButton" Click="Diagram_Click" Padding="6,2" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Diagrama de tablas y relaciones de la base seleccionada en el explorador (o la de la pestaña actual)">
                    <StackPanel Orientation="Horizontal">
                        <!-- Dos tablas relacionadas -->
                        <Canvas Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Path Data="M6,4 H8.5 V10.5 H9" Stroke="#FF3794FF" StrokeThickness="1.2"/>
                            <Path Data="M1,1.5 H6 V6.5 H1 Z M9,8 H13.5 V13 H9 Z" Fill="#FF3794FF"/>
                        </Canvas>
                        <TextBlock Text="Diagrama"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Barra de estado: el mismo componente que usan las ventanas flotantes. -->
        <local:StatusBarView DockPanel.Dock="Bottom" x:Name="StatusView"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="270" MinWidth="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="ExplorerPanel">
                <DockPanel DockPanel.Dock="Top" Background="#FF4D6082">
                    <Button DockPanel.Dock="Right" Content="«" Click="ToggleExplorer_Click" Padding="7,0,7,2" FontSize="14"
                            Background="Transparent" Foreground="White" BorderThickness="0" Focusable="False" Cursor="Hand"
                            ToolTip="Ocultar el explorador de objetos (Ctrl+B)"/>
                    <TextBlock Text="Explorador de objetos" Padding="6,3" Foreground="White" VerticalAlignment="Center"/>
                </DockPanel>
                <!-- Filtro de tablas y vistas (de las bases ya expandidas) -->
                <Grid DockPanel.Dock="Top" Margin="4">
                    <TextBox x:Name="ExplorerFilter" TextChanged="ExplorerFilter_TextChanged"
                             ToolTip="Filtra las tablas y vistas de las bases de datos expandidas"/>
                    <TextBlock x:Name="ExplorerFilterHint" Text="Filtrar tablas..." Margin="11,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource Brush.SecondaryText}"/>
                </Grid>
                <TreeView x:Name="Explorer" BorderThickness="0" TreeViewItem.Expanded="Explorer_Expanded"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" x:Name="ExplorerSplitter" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Splitter}"/>

            <!-- Uno o dos grupos de pestañas (vista dividida); se construyen en código. -->
            <Grid Grid.Column="2" x:Name="GroupsGrid"/>
        </Grid>
    </DockPanel>
</Window>
